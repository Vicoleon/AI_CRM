# .env.example — Cubie settings. rubik_core/config.py is the full list.
# Nothing company-specific has a default: no domain, admin, project, portal,
# pipeline or field name is in the code.

# General
APP_MODE=local  # local, dev_mock_auth or gcp
LOG_LEVEL=INFO
# AI_COST_TRACKING_ENABLED=true (default; false pauses new usage accounting)
# LLM_PRICING_JSON= (optional JSON override for estimated provider rates)
# DISABLE_TELEMETRY=false (optional local diagnostic switch)

# Local development. Mock sign-in never runs in gcp mode.
# ENABLE_MOCK_AUTH=true
# DATABASE_URL=sqlite:///./dev.db
# Who mock sign-in uses when no mock user is named. Provision the workspace
# and its verified domain in the control database first; roles are never
# promoted from the order in which people sign in.
# CUBIE_DEV_USER_EMAIL=dev@acme.example

# Google sign-in. Verified domains are provisioned in the control database.
# GOOGLE_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID= (same OAuth client ID, embedded in the frontend build)
# Google Meet's one-time access-token exchange is a compatibility path only;
# its normal sign-in uses a signed Google ID credential.
VITE_MEET_ADDON_ACCESS_TOKEN_EXCHANGE=false

# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=your-bucket-name

# Platform release scripts read an operator-owned --env file. They fail before
# a build if control is unmigrated, a workspace freeze is active, or the Git
# tree is dirty. Never put a production env file in this repository.
# CLOUDSQL_INSTANCE=your-cloud-sql-instance
# CLOUDSQL_CONNECTION_NAME=your-project-id:us-central1:your-cloud-sql-instance
# CONTROL_DATABASE_URL=postgresql+pg8000://role:password@127.0.0.1:5432/cubie_control (operator's Cloud SQL Auth Proxy)
# CUBIE_OPERATOR_SQL_INSTANCE=project:region:instance (the proxy's configured target)
# CUBIE_RUNTIME_CONTROL_DATABASE_URL=postgresql+pg8000://role:password@/cubie_control?unix_sock=/cloudsql/project:region:instance/.s.PGSQL.5432
# CUBIE_PROVISION_ADMIN_DATABASE_URL= (separate SQL admin URL for fresh bootstrap and onboarding)
# CUBIE_RUNTIME_ADMIN_DATABASE_URL= (same admin identity over the declared Cloud SQL socket; Secret Manager mounts it to the Service)
# CUBIE_RUNTIME_SERVICE_ACCOUNT=cubie-runtime@your-project-id.iam.gserviceaccount.com
# CUBIE_SESSION_SECRET= (high-entropy platform signing secret; provision in Secret Manager)
# CUBIE_OAUTH_STATE_SECRET= (separate high-entropy OAuth state secret; provision in Secret Manager)
# SCHEDULER_API_KEY= (scheduler-to-service authentication key; provision in Secret Manager)
# CUBIE_PROVISION_REGION=us-central1
# CUBIE_PROVISION_SERVICE_URL=https://your-service-url
# VITE_MEET_ADDON_CLOUD_PROJECT_NUMBER=your-project-number
# GOOGLE_GMAIL_OAUTH_CLIENT_ID= (optional, with the secret and redirect URI below)
# GOOGLE_GMAIL_OAUTH_CLIENT_SECRET= (operator env only; bootstrap stores it in Secret Manager)
# GOOGLE_GMAIL_OAUTH_REDIRECT_URI=https://your-public-origin/api/...
# CUBIE_SQL_TIER=db-custom-1-3840 (only when creating a new SQL instance)
# CUBIE_PLATFORM_PYTHON=.venv/bin/python
# CUBIE_PROVISION_DB_MAX_CONNECTIONS=100
# CUBIE_PROVISION_SERVICE_MAX_INSTANCES=3
# CUBIE_PROVISION_JOB_MAX_INSTANCES=4
# CUBIE_PROVISION_RESERVED_CONNECTIONS=10
# Each active workspace's control row owns its weekly deploy freezes. The
# legacy process-wide value is checked as an additional platform freeze.
# CUBIE_DEPLOY_FREEZE="TUE 08:00-12:00 America/Costa_Rica"
# The one public origin the Chrome extension's store build may talk to
# (scripts/pack_chrome_extension.py; --origin overrides it).
# CUBIE_PUBLIC_ORIGIN=https://cubie.acme.example

# Vertex AI Models
# Three tiers, defaulted in rubik_core/config.py — override only to pin or roll
# back a family. There is no single-model setting.
# Gemini 3.x is served on the *global* endpoint only, hence VERTEX_LLM_LOCATION.
VERTEX_LLM_MODEL_LITE=gemini-3.5-flash-lite
VERTEX_LLM_MODEL_FLASH=gemini-3.8-flash
VERTEX_LLM_MODEL_PRO=gemini-2.5-pro
VERTEX_LLM_LOCATION=global
VERTEX_EMBEDDING_MODEL=text-embedding-004

# Thinking knobs (latency). 2.5 uses a numeric budget; 3.x uses a level and
# silently IGNORES a budget. Two levels because the tiers differ: "minimal" is
# zero thinking tokens — right for one-shot extraction on Flash-Lite, wrong for
# the chat coordinator, where thinking-off is what caused the "Migration Plan"
# hallucination. Blank either to keep the model's own default.
# The level scale is per-family: 3.8's "low" thinks about as little as "minimal"
# used to, so chat runs "medium" there. Roll this back to "low" if you roll
# VERTEX_LLM_MODEL_FLASH back to a 3.6-or-older id. "minimal" is a hard 400 on
# 3.7+ — gemini_tuning floors it rather than sending it.
CHAT_LLM_THINKING_BUDGET=512
CHAT_LLM_THINKING_LEVEL=medium
LITE_LLM_THINKING_LEVEL=minimal

# Knowledge corpus
# Local mode keeps vectors in Chroma; gcp mode uses the Vertex AI RAG Engine.
CHROMA_PERSIST_DIR=./storage
# VERTEX_RAG_CORPUS_ID=
# VERTEX_RAG_LOCATION=

# Local Ingestion. Configure Fathom credentials per workspace in Admin.
LOCAL_DATA_DIR=./data

# HubSpot portal, pipeline, stage and property configuration belongs to each
# workspace in Admin → Access → Google Workspace. Deal reads and writes stay closed until its
# own pipelines are configured there.

# Business time zone, ingestion health audience, Insights exclusions, sender
# mailboxes and L10 recap start date belong to Admin → Access → Google
# Workspace → Workspace operations. Person-impersonation grants are platform
# managed. None of these company policies is read from the process environment.

# Sales Call Capture (CCS) + Sales Cockpit
# Most of this ships gated off. Most of these flags depend on a grant that
# lives outside this repo, so a fresh environment is normally only PART
# provisioned and must not part-run the feature. Turn one on only once its
# dependency is real: CCS_MEET_ENABLED needs the four Meet scopes on the DWD
# client ID (until then every Meet call 403s). CCS_EVENT_PUSH_ENABLED waits on
# a build, not a grant. CCS_LEADS_ENABLED needs the HubSpot Lead scopes on the
# private-app token; it defaults on and is a kill switch.
CCS_ENABLED=false
COCKPIT_ENABLED=false
CCS_MEET_ENABLED=false
# Fathom recordings become captured calls (on by default; see config.py).
CCS_FATHOM_ENABLED=true
CCS_LEADS_ENABLED=true
COCKPIT_DIGEST_ENABLED=false
# Phase-2 only. v1 detects calls by POLLING conferenceRecords.list on Cloud
# Scheduler, alongside transcript_sync.py's existing 15-minute sweep. There are
# zero Pub/Sub push receivers in this repo, so push would mean hand-writing a
# service-account OIDC verifier.
CCS_EVENT_PUSH_ENABLED=false

# How far back each conference-record sweep looks. Overlap is free (ingest is
# idempotent) and a missed window is a permanently lost call — Google deletes
# conference records and transcript entries 30 days after the conference ends.
CCS_POLL_LOOKBACK_HOURS=24

# Recording stays off: transcription is what the extractor reads, and audio is
# a far larger consent/retention surface for no extra signal.
MEET_AUTO_RECORD_DEFAULT=false
MEET_AUTO_SMART_NOTES=true

# DEFERRED PUSH PATH — unused in v1, and the topic named here WAS NEVER
# CREATED, so leave all three blank/default rather than hunting for it in GCP.
# They configure the Workspace Events → Pub/Sub ingest behind
# CCS_EVENT_PUSH_ENABLED. The receiver verifies the push's OIDC token against
# MEET_PUBSUB_AUDIENCE and refuses it otherwise — Pub/Sub retries hard on a
# non-2xx, so an unauthenticated receiver is a loop anyone can start.
MEET_PUBSUB_TOPIC=
MEET_PUBSUB_AUDIENCE=
# Also unused in v1, which creates no subscriptions. On expiry Google
# PERMANENTLY DELETES a subscription (recreate only), so renew early. Max TTL is
# 7 days while includeResourceData is false.
MEET_SUBSCRIPTION_RENEW_WITHIN_HOURS=72

# Extraction. Blank model = the PRO tier; pin a full id, never a `-latest`
# alias. The vendor fields are the company's own HubSpot company properties
# (internal names, comma-separated) the extractor is asked to fill, and the
# only company properties Call Capture may write; empty asks for, and writes,
# none.
CCS_EXTRACTION_MODEL=
CCS_PROMPT_VERSION=ccs-extract-v1
CCS_MIN_CONFIDENCE_SHOW=0.5
CCS_VENDOR_FIELDS_DEFAULT=
CCS_VENDOR_FIELDS_EXTENDED=
# 0 = keep indefinitely. Explicit, not assumed: retention is the company's own
# policy decision. Google deletes its own Meet transcripts at 30 days, so this
# governs the only remaining copy.
CCS_TRANSCRIPT_RETENTION_DAYS=0

# Transcript coverage — "did we hear the whole call?". A host can stop
# transcription mid-call from the Meet UI (auto-transcription is a default, not
# a lock, and no Meet API method can stop or start it on a running conference),
# and the truncated transcript is indistinguishable from a complete one at the
# API level. Coverage compares the last utterance offset against the
# conference's own start/end and says so on the wrap-up. A call is called
# truncated only when BOTH hold — ratio below MIN_RATIO **and** gap above
# MIN_GAP_SECONDS. Either alone cries wolf (a 4-minute call ending 40 seconds
# early; the silent tail of every long call), and a banner the AE learns to
# ignore is worth less than no banner.
CCS_COVERAGE_MIN_RATIO=0.85
CCS_COVERAGE_MIN_GAP_SECONDS=180

# Cockpit. SLAs are in BUSINESS hours at COCKPIT_BUSINESS_DAY_HOURS in the
# workspace's control-row IANA time zone — "3 business days" is stored as 24.
COCKPIT_BUSINESS_DAY_HOURS=8
COCKPIT_STAGE_LAG_MIN_CONFIDENCE=0.7
# Stage lag and Sales rhythm stages are configured for each workspace in Admin.
COCKPIT_MAX_INAPP_ITEMS=3
